{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/captions/generate",
      "destination": "/api/captions/generate"
    },
    {
      "source": "/api/captions/tts",
      "destination": "/api/captions/tts"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/templates",
      "destination": "/api/templates"
    },
    {
      "source": "/api/text-templates",
      "destination": "/api/text-templates"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
